# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud → App settings → Secrets.
GEMINI_API_KEY = "your-key-from-aistudio.google.com"
GEMINI_MODEL = "gemini-2.5-flash"
GEMINI_FALLBACK_MODEL = "gemini-2.5-flash-lite"
# Recommended: permanent storage (free Supabase Postgres). Without it, a local SQLite file is used,
# which Streamlit Cloud wipes when the app restarts or wakes from sleep.
DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
